# --- Base de donnees MySQL ---
DB_URL=jdbc:mysql://localhost:3306/kalpee_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=kalpee_user
DB_PASSWORD=change-me

# --- Frontend (pour CORS + redirections OAuth) ---
FRONTEND_URL=http://localhost:3000

# --- JWT ---
# Genere avec: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-base64-secret-at-least-64-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Apple Sign-In ---
APPLE_CLIENT_ID=
APPLE_BUNDLE_IDS=

# --- Uploads (photos d'articles) ---
UPLOADS_DIR=./uploads
